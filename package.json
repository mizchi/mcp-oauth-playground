{
  "name": "mcp-oauth-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host localhost --port 5173 --strictPort",
    "dev:local": "LOGIN_PROVIDER=local ENABLE_DCR=true vp dev --host localhost --port 5173 --strictPort",
    "test": "vp test run -c vitest.config.ts && node --test tests/audit/*.test.mjs tests/snippets/*.test.mjs",
    "test:audit": "node --test tests/audit/*.test.mjs",
    "audit:auth": "node scripts/mcp-auth-audit.mjs",
    "test:e2e": "playwright test",
    "test:production": "vp build && node scripts/check-production.mjs",
    "typecheck": "tsc --noEmit",
    "check": "void prepare && tsc --noEmit && tsc -p hono/tsconfig.json && vp check",
    "build": "vp build",
    "deploy": "void deploy --platform cloudflare",
    "prepare": "void prepare",
    "dev:hono": "wrangler dev --cwd hono --config wrangler.jsonc --port 8791 --ip localhost --persist-to .wrangler/hono-github --var PUBLIC_ORIGIN:http://localhost:8791",
    "dev:hono:local": "wrangler dev --cwd hono --config wrangler.local.jsonc --port 8791 --ip localhost --persist-to .wrangler/hono-local",
    "test:e2e:hono": "playwright test --config playwright.hono.config.ts",
    "typecheck:hono": "tsc -p hono/tsconfig.json",
    "build:hono": "wrangler deploy --dry-run --cwd hono --config wrangler.jsonc --outdir .wrangler/hono-build --metafile",
    "test:production:hono": "pnpm build:hono && node scripts/check-hono-production.mjs",
    "test:snippets": "vp test run -c vitest.config.ts tests/auth.test.ts && node --test tests/snippets/*.test.mjs",
    "test:e2e:gist": "playwright test --config playwright.gist.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "1.6.1",
    "miniflare": "5.20261104.0-beta",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "void": "^1.6.1",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
