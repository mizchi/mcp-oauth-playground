PUBLIC_ORIGIN=http://localhost:5173
LOGIN_PROVIDER=github
GITHUB_CLIENT_ID=replace-with-your-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-oauth-app-client-secret
# Numeric GitHub account IDs; login names are not accepted.
ALLOWED_GITHUB_USER_IDS=73962
# Older MCP clients may need DCR. Prefer CIMD when available.
ENABLE_DCR=false
